# ==============================================================================
# BẢNG THAM SỐ CẤU HÌNH MÔI TRƯỜNG CHO TÁC NHÂN GIỮ ẤM SUPABASE
# ==============================================================================

# Danh sách các cơ sở dữ liệu Supabase cần giữ ấm
# Định dạng: URL|ANON_KEY|TABLE, cách nhau bởi dấu phẩy nếu có nhiều dự án
SUPABASE_TARGETS=https://your-project-id.supabase.co|your_supabase_anon_key_here|dim_employee

# Chu kỳ gửi truy vấn làm mới bộ đếm 7 ngày (mặc định: 6 tiếng một lần)
PING_INTERVAL_HOURS=6

# Cấu hình Telegram thông báo trạng thái hoạt động định kỳ
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
