# ==============================================================================
# BẢNG THAM SỐ CẤU HÌNH MÔI TRƯỜNG CHO AI AGENT SÀNG LỌC CV
# Sao chép tập tin này thành '.env' và điền các khóa thực tế của bạn
# ==============================================================================

# Khóa kết nối Google AI Studio (Lấy miễn phí tại: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-2.5-flash

# Cấu hình Google Sheets ghi nhận dữ liệu ứng viên
# ID của file Google Sheet (chuỗi ký tự nằm giữa /d/ và /edit trên thanh địa chỉ trình duyệt)
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_NAME=Ứng Viên Tuyển Dụng
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Cấu hình Google Drive (ID thư mục nhận CV và thư mục lưu trữ Talent Pool)
DRIVE_INCOMING_FOLDER_ID=your_drive_incoming_folder_id_here
DRIVE_TALENT_POOL_FOLDER_ID=your_drive_talent_pool_folder_id_here

# Cấu hình Telegram Bot cảnh báo lỗi và kết quả tức thì
# Lấy Bot Token từ @BotFather và Chat ID từ @userinfobot trên Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Chu kỳ quét tập tin mới (mặc định: 10 phút một lần)
POLLING_INTERVAL_MINUTES=10
